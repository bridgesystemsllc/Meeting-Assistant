# [PRODUCT NAME] Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/meeting_assistant

# Redis
REDIS_URL=redis://localhost:6379

# Recall.ai (required for webhooks)
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Anthropic Claude (required for analysis)
ANTHROPIC_API_KEY=

# Email (optional - for recap emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=debug
