# [PRODUCT NAME] Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (owner / migrations). Never used as the app/worker query role.
DATABASE_URL=postgres://owner:password@localhost:5432/meeting_assistant
# App role (NOBYPASSRLS). Required for API and worker — no fallback to DATABASE_URL.
# On managed Postgres (NOSUPERUSER NOBYPASSRLS owner), run db/bootstrap-roles.sql
# as a superuser once before migrations: psql -v ON_ERROR_STOP=1 -f db/bootstrap-roles.sql
APP_DATABASE_URL=postgres://meeting_assistant_app:password@localhost:5432/meeting_assistant

# Sessions (httpOnly cookie; values are durations, not secrets)
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=43200
COOKIE_SECURE=

# Public API origin used to build OIDC redirect_uri (never taken from Host).
PUBLIC_BASE_URL=
# HMAC secret for the short-lived OIDC state cookie. Required in production.
OIDC_STATE_SECRET=
# id_token iat window (seconds). Defaults: max age 300, clock skew 60.
OIDC_ID_TOKEN_MAX_AGE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=60

# OIDC (Authorization Code + PKCE). Names only — put values in .env, never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ISSUER=https://login.microsoftonline.com/organizations/v2.0
OIDC_ALLOW_MOCK=

# Redis
REDIS_URL=redis://localhost:6379

# Recall.ai (required for webhooks)
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Anthropic Claude (required for analysis)
ANTHROPIC_API_KEY=

# Email (optional - for recap emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=debug
