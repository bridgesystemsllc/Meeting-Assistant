# [PRODUCT NAME] Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (owner / migrations)
DATABASE_URL=postgres://user:password@localhost:5432/meeting_assistant
# App role (NOBYPASSRLS). Required — the API will not fall back to DATABASE_URL.
APP_DATABASE_URL=

# Sessions (httpOnly cookie; values are durations, not secrets)
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=43200
COOKIE_SECURE=

# Public API origin used to build OIDC redirect_uri (never taken from Host).
PUBLIC_BASE_URL=
# HMAC secret for the short-lived OIDC state cookie.
OIDC_STATE_SECRET=

# OIDC (Authorization Code + PKCE). Names only — put values in .env, never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ISSUER=https://login.microsoftonline.com/organizations/v2.0
OIDC_ALLOW_MOCK=

# Redis
REDIS_URL=redis://localhost:6379

# Recall.ai (required for webhooks)
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Anthropic Claude (required for analysis)
ANTHROPIC_API_KEY=

# Email (optional - for recap emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=debug
