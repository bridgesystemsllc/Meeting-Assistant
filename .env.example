# [PRODUCT NAME] Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (owner / migrations)
DATABASE_URL=postgres://user:password@localhost:5432/meeting_assistant
# App role (NOBYPASSRLS). Leave empty to reuse DATABASE_URL in local-only fallback.
DATABASE_APP_URL=

# Sessions (httpOnly cookie; values are durations, not secrets)
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=43200
COOKIE_SECURE=

# OIDC (Authorization Code + PKCE). Names only — put values in .env, never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ISSUER=https://login.microsoftonline.com/organizations/v2.0
OIDC_REDIRECT_BASE=
OIDC_ALLOW_MOCK=

# Redis
REDIS_URL=redis://localhost:6379

# Recall.ai (required for webhooks)
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Anthropic Claude (required for analysis)
ANTHROPIC_API_KEY=

# Email (optional). Leave SMTP_HOST empty to use the dev/log transport.
# The log transport prints the invite link and stores no secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
INVITE_TTL_DAYS=7

# HMAC key for invitee emails stored on audit_events. Name only — put the
# value in .env, never commit it. Required when writing invite audit rows.
AUDIT_EMAIL_HMAC_KEY=

# Logging
LOG_LEVEL=debug
